# 4-digit PIN for the web app.
DEVICE_PIN=7777

# Used to sign the login cookie. Replace this with a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# live talks to the ESP32. mock shows sample readings so you can try the UI.
ESP32_MODE=live

# Address printed by the ESP32 in the Arduino Serial Monitor.
ESP32_HOST=http://h2grow.local

# Must match DEVICE_KEY in firmware/h2grow/config.h.
DEVICE_KEY=h2grow-local
